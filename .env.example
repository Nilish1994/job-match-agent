# Copy to .env (git-ignored) and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your own chat: admin commands, invite approvals, budget alerts. Leave empty at first,
# message your bot, and it replies with your chat id. (TELEGRAM_CHAT_ID is the old name.)
OWNER_CHAT_ID=
# Encrypts user profiles at rest. Generate once and keep it safe; losing it makes profiles unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=

# Optional (defaults shown)
# JOBS_FEED_URL=http://api:8000/feed/jobs
# SCORE_MODEL=claude-opus-5-5
# DRAFT_MODEL=claude-opus-5-5
# TIMEZONE=Australia/Melbourne
# DAILY_HOUR=8              # local hour the matching run starts
# RUN_WEEKDAY=               # e.g. sunday to match weekly; empty = every day (follow-ups are always daily)
# MIN_SCORE=70
# MAX_DIGEST=5
# SCORE_BATCH=8
# MAX_SCORED_PER_RUN=150    # per user, per run
# MAX_DRAFTS_PER_DAY=10     # per user
# WEEKLY_BUDGET_USD=15      # all users combined; scoring and drafting pause when reached
# MAX_JOB_AGE_DAYS=14
# FOLLOW_UP_DAYS=7
